#include <LiquidCrystal_I2C.h> //Biblioteca LCD_I2C
#include <Wire.h>              //Biblioteca auxiliar

//Pinos do LED RGB
int Red = 3;     //Pino vermelho
int Green = 4;   //Pino verde

//Sensor de ruído LM393
int sensor = 2;

//Instanciando o LCD I2C
LiquidCrystal_I2C lcd(0x27, 16, 2);

void setup() {

  Serial.begin(9600); //Iniciando a comunicação serial

  //Configuração dos LEDs
  pinMode(Red, OUTPUT);
  pinMode(Green, OUTPUT);

  //Configuração do sensor
  pinMode(sensor, INPUT);

  //Iniciando o LCD
  lcd.init();
  lcd.backlight();
  lcd.clear();
}

void loop() {

  int leitura = digitalRead(sensor);

  //Se detectar som/movimento
  if (!leitura) {
    digitalWrite(Red, HIGH);
    digitalWrite(Green, LOW);
  
    //Mensagem no LCD
    lcd.setCursor(4, 0);
    lcd.print("Alerta!");

    lcd.setCursor(4, 1);
    lcd.print("Defeito!");

    delay(400);

    //Apaga LCD e LED
    lcd.clear();
    } else {
    //LED verde ligado (normal)
    digitalWrite(Red, LOW);
    digitalWrite(Green, HIGH);

    lcd.setCursor(0, 0);
    lcd.print("Sistema OK");
  }
}
